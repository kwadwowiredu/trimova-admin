# Copy this file to .env.local and fill in real values.

# The Node/Express API that also backs the React Native apps. Must match the
# PORT in the api project's .env (3000 by default).
#
#  • Same machine:      http://localhost:3000/api
#  • Another device:    http://<your-lan-ip>:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Signs the admin session cookie. Use a long random string — anyone who knows
# it can forge an admin session.
ADMIN_SESSION_SECRET=

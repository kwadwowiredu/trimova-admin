# ---------------------------------------------------------------------------
# Trimova Admin — local environment configuration
# These roots MUST match the parameters used by the React Native mobile client
# so the web admin panel talks to the exact same backend ecosystem.
# ---------------------------------------------------------------------------

# Node/Express API server that the mobile app already consumes
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase (PostgreSQL + PostGIS) — shared with the mobile backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Admin-panel-only secrets (never exposed to the browser — no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# Used to sign/verify the admin session cookie in the auth server actions.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" to use the built-in mock auth + mock data while the real
# backend is not yet wired up. Set to "false" once NEXT_PUBLIC_API_URL is live.
NEXT_PUBLIC_USE_MOCKS=true

# ---------------------------------------------------------------------------
# Trimova Admin — local environment configuration
#
# The panel has no database client of its own: everything goes through the
# same Express API the mobile apps use, so one set of rules governs all three.
# ---------------------------------------------------------------------------

# Must match the PORT in trimova/api/.env (3000 by default).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Server-only secret (no NEXT_PUBLIC_ prefix, never reaches the browser)
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Replace this with a long random string —
# anyone who knows it can forge an admin session.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
